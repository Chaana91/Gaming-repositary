    const ex = x + fx * r * 0.32 + sx * side * r * 0.44, ey = y + fy * r * 0.32 + sy * side * r * 0.44;
    g.fillStyle = '#fff'; g.beginPath(); g.arc(ex, ey, er, 0, TAU); g.fill(); g.stroke();
    g.fillStyle = '#1d2b36'; g.beginPath(); g.arc(ex + lx, ey + ly, pr, 0, TAU); g.fill();
    g.fillStyle = '#fff'; g.beginPath(); g.arc(ex + lx - pr * 0.35, ey + ly - pr * 0.4, pr * 0.36, 0, TAU); g.fill();
  }
}
function drawCrown(g, x, y, s) {
  g.save(); g.translate(x, y); g.scale(s, s);
  g.beginPath(); g.moveTo(-12, 6); g.lineTo(-14, -8); g.lineTo(-6, -1); g.lineTo(0, -12); g.lineTo(6, -1); g.lineTo(14, -8); g.lineTo(12, 6); g.closePath();
  g.fillStyle = '#ffca3a'; g.fill(); g.lineJoin = 'round'; g.lineWidth = 2.5; g.strokeStyle = '#1d2b36'; g.stroke();
  g.restore();
}
function drawSnake(s, leader) {
  const pts = s.pts, r = s.r, n = pts.length;
  const alpha = s.grace > 0 ? (Math.floor(s.grace / 6) % 2 ? 0.45 : 0.75) : 1;
  if (s.boosting) {
    ctx.globalAlpha = 0.22 * alpha; ctx.fillStyle = s.skin.style === 'rainbow' ? '#fff' : s.skin.a;
    for (let i = n - 1; i >= 0; i -= 2) { const p = pts[i]; if (!inView(p.x, p.y, r * 1.6)) continue; ctx.beginPath(); ctx.arc(p.x, p.y, r * 1.55, 0, TAU); ctx.fill(); }
  }
  ctx.globalAlpha = alpha;
  ctx.fillStyle = s.skin.dark;
  for (let i = n - 1; i >= 0; i--) { const p = pts[i]; if (!inView(p.x, p.y, r + 4)) continue; ctx.beginPath(); ctx.arc(p.x, p.y, r + 2.6, 0, TAU); ctx.fill(); }
  for (let i = n - 1; i >= 0; i--) {
    const p = pts[i]; if (!inView(p.x, p.y, r)) continue;
    ctx.fillStyle = segColor(s.skin, i); ctx.beginPath(); ctx.arc(p.x, p.y, r, 0, TAU); ctx.fill();
    ctx.fillStyle = 'rgba(255,255,255,.26)'; ctx.beginPath(); ctx.arc(p.x - r * 0.3, p.y - r * 0.34, r * 0.32, 0, TAU); ctx.fill();
  }
  const h = pts[0];
  if (inView(h.x, h.y, r * 3)) {
    drawEyes(ctx, h.x, h.y, s.angle, s.target, r);
    const fs = clamp(r * 0.8, 12, 24);
    ctx.font = `800 ${fs}px Nunito, "Segoe UI", sans-serif`; ctx.textAlign = 'center'; ctx.textBaseline = 'bottom';
    ctx.lineJoin = 'round'; ctx.lineWidth = 4; ctx.strokeStyle = 'rgba(29,43,54,.9)'; ctx.fillStyle = '#fff';
    const ty = h.y - r - 8;
    ctx.strokeText(s.name, h.x, ty); ctx.fillText(s.name, h.x, ty);
    if (leader) drawCrown(ctx, h.x, ty - fs - 10, clamp(r / 16, 0.9, 1.8));
  }
  ctx.globalAlpha = 1;
}
function render() {
  ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
  ctx.fillStyle = '#7fb391'; ctx.fillRect(0, 0, W, H);
  const z = cam.z;
  vx0 = cam.x - W / 2 / z; vx1 = cam.x + W / 2 / z; vy0 = cam.y - H / 2 / z; vy1 = cam.y + H / 2 / z;
  ctx.save();
  ctx.translate(W / 2, H / 2); ctx.scale(z, z); ctx.translate(-cam.x, -cam.y);

  ctx.beginPath(); ctx.arc(0, 0, WORLD_R, 0, TAU); ctx.fillStyle = grassPat; ctx.fill();
  ctx.lineWidth = 16; ctx.setLineDash([46, 28]);
  ctx.strokeStyle = M.softEdge ? 'rgba(89,195,255,.9)' : 'rgba(239,71,111,.85)';
  ctx.beginPath(); ctx.arc(0, 0, WORLD_R + 8, 0, TAU); ctx.stroke(); ctx.setLineDash([]);

  const t = clock * 0.06;
  for (let i = 0; i < foods.length; i++) {
    const f = foods[i]; if (!inView(f.x, f.y, f.r * 2.2)) continue;
    const rr = f.r * (1 + 0.14 * Math.sin(t + f.ph));
    ctx.globalAlpha = 0.22; ctx.fillStyle = f.c; ctx.beginPath(); ctx.arc(f.x, f.y, rr * 2, 0, TAU); ctx.fill();
    ctx.globalAlpha = 1; ctx.beginPath(); ctx.arc(f.x, f.y, rr, 0, TAU); ctx.fill();
    ctx.fillStyle = 'rgba(255,255,255,.7)'; ctx.beginPath(); ctx.arc(f.x - rr * 0.3, f.y - rr * 0.3, rr * 0.33, 0, TAU); ctx.fill();
  }

  let leader = null; for (const s of snakes) if (s.alive && (!leader || s.mass > leader.mass)) leader = s;
  for (const s of snakes) if (s.alive && !s.isPlayer) drawSnake(s, s === leader);
  if (player && player.alive) drawSnake(player, player === leader);

  for (const fx of effects) {
    ctx.globalAlpha = 1 - fx.t; ctx.strokeStyle = fx.c; ctx.lineWidth = 6 * (1 - fx.t) + 1;
    ctx.beginPath(); ctx.arc(fx.x, fx.y, fx.r * (1 + fx.t * 5), 0, TAU); ctx.stroke();
  }
  ctx.globalAlpha = 1;
  ctx.restore();

  if (player && player.alive && state === 'playing') {
    const h = player.pts[0], d = Math.hypot(h.x, h.y);
    if (!M.softEdge && d > WORLD_R - 420) {
      ctx.fillStyle = `rgba(239,71,111,${clamp((d - (WORLD_R - 420)) / 420, 0, 1) * 0.18})`;
      ctx.fillRect(0, 0, W, H);
    }
  }
}
function renderMinimap() {
  const S = mm.width, c = S / 2, k = (S / 2 - 8) / WORLD_R;
  mctx.clearRect(0, 0, S, S);
  mctx.fillStyle = '#e9f6ec'; mctx.beginPath(); mctx.arc(c, c, S / 2 - 4, 0, TAU); mctx.fill();
  mctx.strokeStyle = M.softEdge ? '#59c3ff' : '#ef476f'; mctx.lineWidth = 4; mctx.stroke();
  for (const s of snakes) {
    if (!s.alive || s.isPlayer) continue;
    const h = s.pts[0];
    mctx.fillStyle = s.skin.a; mctx.beginPath(); mctx.arc(c + h.x * k, c + h.y * k, 3 + Math.sqrt(s.mass) * 0.35, 0, TAU); mctx.fill();
  }
  if (player && player.alive) {
    const h = player.pts[0];
    mctx.fillStyle = '#fff'; mctx.strokeStyle = '#1d2b36'; mctx.lineWidth = 3;
    mctx.beginPath(); mctx.arc(c + h.x * k, c + h.y * k, 9, 0, TAU); mctx.fill(); mctx.stroke();
  }
}
let hudTick = 0;
function renderHud() {
  if (!player) return;
  $('sLen').textContent = Math.floor(player.mass);
  $('sKills').textContent = player.kills;
  $('sRank').textContent = player.alive ? `${run.rank || 1} / ${snakes.length}` : '–';
  const list = snakes.filter(s => s.alive).sort((a, b) => b.mass - a.mass);
  const top = W < 600 ? 5 : 8, ol = $('boardList');
  ol.textContent = '';
  const row = (s, i) => {
    const li = document.createElement('li'); if (s.isPlayer) li.className = 'me';
    const rk = document.createElement('span'); rk.className = 'rk'; rk.textContent = i + 1;
    const dot = document.createElement('span'); dot.className = 'dot'; dot.style.background = s.skin.a;
    const nm = document.createElement('span'); nm.className = 'nm'; nm.textContent = s.name;
    const sc = document.createElement('span'); sc.className = 'sc'; sc.textContent = Math.floor(s.mass);
    li.append(rk, dot, nm, sc); ol.append(li);
  };
  list.slice(0, top).forEach(row);
  const pi = list.indexOf(player);
  if (pi >= top) { const gap = document.createElement('li'); gap.className = 'gap'; ol.append(gap); row(player, pi); }
}

/* ---------- Menu ---------- */
function renderMenu() {
  const sk = $('skins');
  if (!sk.children.length) {
    SKINS.forEach((s, i) => {
      const b = document.createElement('button'); b.className = 'skin'; b.setAttribute('role', 'radio'); b.id = 'skin-' + s.id;
      b.setAttribute('aria-label', s.name);
      b.style.background = s.style === 'rainbow'
        ? `conic-gradient(${RAINBOW.join(',')},${RAINBOW[0]})`
        : `repeating-linear-gradient(45deg, ${s.a} 0 7px, ${s.b} 7px 12px)`;
      b.addEventListener('click', () => { skinIdx = i; store.set('skin', i); renderMenu(); });
      sk.append(b);
    });
  }
  [...sk.children].forEach((b, i) => b.setAttribute('aria-checked', i === skinIdx ? 'true' : 'false'));
  $('skinName').textContent = SKINS[skinIdx].name;
  document.querySelectorAll('.mode').forEach(b => b.setAttribute('aria-checked', b.dataset.mode === modeKey ? 'true' : 'false'));
  const best = store.get('best.' + modeKey, 0) | 0;
  $('bestMenu').innerHTML = '';
  $('bestMenu').append(`Your best in ${MODES[modeKey].label}: `);
  const bb = document.createElement('b'); bb.textContent = best; $('bestMenu').append(bb);
}
document.querySelectorAll('.mode').forEach(b => b.addEventListener('click', () => {
  const k = b.dataset.mode; if (k === modeKey) return;
  store.set('mode', k); resetWorld(k); renderMenu();
}));
function renderPreview() {
  const g = pctx, w = pv.width, h = pv.height, s = SKINS[skinIdx];
  g.setTransform(1, 0, 0, 1, 0, 0);
  g.fillStyle = previewPat; g.fillRect(0, 0, w, h);
  const r = 17, n = 26, pts = [];
  for (let i = 0; i < n; i++) { const x = 520 - i * 15; pts.push({ x, y: h / 2 + Math.sin(x * 0.018 - clock * 0.07) * 24 }); }
  g.fillStyle = s.dark;
  for (let i = n - 1; i >= 0; i--) { g.beginPath(); g.arc(pts[i].x, pts[i].y, r + 2.6, 0, TAU); g.fill(); }
  for (let i = n - 1; i >= 0; i--) {
    g.fillStyle = segColor(s, i); g.beginPath(); g.arc(pts[i].x, pts[i].y, r, 0, TAU); g.fill();
    g.fillStyle = 'rgba(255,255,255,.26)'; g.beginPath(); g.arc(pts[i].x - r * 0.3, pts[i].y - r * 0.34, r * 0.32, 0, TAU); g.fill();
  }
  const a = Math.atan2(pts[0].y - pts[1].y, pts[0].x - pts[1].x);
  drawEyes(g, pts[0].x, pts[0].y, a, a, r);
  const fx = 590, fy = h / 2 + Math.sin(clock * 0.05) * 6;
  g.fillStyle = 'rgba(255,202,58,.3)'; g.beginPath(); g.arc(fx, fy, 16, 0, TAU); g.fill();
  g.fillStyle = '#ffca3a'; g.beginPath(); g.arc(fx, fy, 8, 0, TAU); g.fill();
}

/* ---------- Buttons ---------- */
$('btnPlay').addEventListener('click', startGame);
$('btnAgain').addEventListener('click', startGame);
$('btnMenu').addEventListener('click', showMenu);
$('btnResume').addEventListener('click', () => setPaused(false));
$('btnQuit').addEventListener('click', showMenu);
$('btnPause').addEventListener('click', () => setPaused(true));
$('btnSound').addEventListener('click', () => { muted = !muted; store.set('muted', muted); ensureAudio(); renderSound(); });

/* ---------- Loop ---------- */
let last = performance.now();
function frame(now) {
  let dt = (now - last) / 16.667; last = now;
  dt = clamp(dt, 0.25, 3);
  if (state !== 'paused') update(dt);
  updateCamera(dt);
  render();
  if (state === 'menu' && !$('menu').hidden) renderPreview();
  if (state === 'playing' || state === 'dead') {
    if ((hudTick++ % 8) === 0) { renderHud(); renderMinimap(); }
  }
  requestAnimationFrame(frame);
}

$('nameInput').value = store.get('name', '');
renderSound();
resetWorld(modeKey);
const first = snakes.reduce((m, s) => (!m || s.mass > m.mass) ? s : m, null);
if (first) { cam.x = first.pts[0].x; cam.y = first.pts[0].y; cam.follow = first; }
renderMenu();
renderPreview();
requestAnimationFrame(frame);
})();
</script>

