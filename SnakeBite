<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="description" content="Wiggle Arena: a free snake game for all ages. Eat, grow, and become the longest snake.">
</head>
<body>
<title>Wiggle Arena</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;800&family=Nunito:wght@600;800;900&display=swap">
<style>
/* Layout: full-bleed canvas arena; chunky "sticker" HUD panels pinned to the corners; one centered card for menus */
:root{
  --grass:#b9e4c4;
  --grass-deep:#7fb391;
  --ink:#1d2b36;
  --paper:#fffdf6;
  --tang:#ff8a3d;
  --tang-deep:#c8571a;
  --berry:#ef476f;
  --muted:#53646f;
  --display:"Baloo 2","Arial Rounded MT Bold","Trebuchet MS",system-ui,sans-serif;
  --body:"Nunito","Segoe UI",system-ui,-apple-system,sans-serif;
  --edge-t:calc(env(safe-area-inset-top,0px) + 12px);
  --edge-b:calc(env(safe-area-inset-bottom,0px) + 12px);
  --edge-l:max(14px, calc(env(safe-area-inset-left,0px) + 12px));
  --edge-r:max(14px, calc(env(safe-area-inset-right,0px) + 12px));
  color-scheme:light;
}
html,body{height:100%;overflow:hidden}
body{
  margin:0;background:var(--grass);color:var(--ink);font-family:var(--body);
  padding-left:max(16px, env(safe-area-inset-left,0px));
  padding-right:max(16px, env(safe-area-inset-right,0px));
  -webkit-user-select:none;user-select:none;-webkit-tap-highlight-color:transparent;
}
#game{position:fixed;inset:0;display:block;touch-action:none;cursor:crosshair}
.sticker{background:var(--paper);border:3px solid var(--ink);border-radius:16px;box-shadow:0 4px 0 var(--ink)}
button{font:inherit;color:inherit;cursor:pointer}
button:focus-visible,input:focus-visible{outline:3px solid var(--tang);outline-offset:3px}

/* ---------- HUD ---------- */
#hud{position:fixed;inset:0;pointer-events:none}
#hud > *{pointer-events:auto}
.stats{position:absolute;top:var(--edge-t);left:var(--edge-l);padding:8px 14px 10px;min-width:132px}
.stats .lbl{display:block;font-size:11px;font-weight:900;letter-spacing:.12em;text-transform:uppercase;color:var(--muted)}
.stats .big{font-family:var(--display);font-weight:800;font-size:38px;line-height:1;font-variant-numeric:tabular-nums}
.stat-row{display:flex;gap:14px;font-size:13px;font-weight:800;margin-top:4px;color:var(--muted)}
.stat-row b{color:var(--ink);font-variant-numeric:tabular-nums}
.tools{position:absolute;top:calc(var(--edge-t) + 100px);left:var(--edge-l);display:flex;gap:8px}
.icon-btn{width:42px;height:42px;display:grid;place-items:center;padding:0;border-radius:12px}
.icon-btn:active{transform:translateY(3px);box-shadow:0 1px 0 var(--ink)}
.icon-btn svg{width:20px;height:20px}
.board{position:absolute;top:var(--edge-t);right:var(--edge-r);width:200px;padding:8px 12px 10px}
.board h2{margin:0 0 4px;font-size:11px;font-weight:900;letter-spacing:.12em;text-transform:uppercase;color:var(--muted)}
.board ol{list-style:none;margin:0;padding:0;display:grid;gap:1px}
.board li{display:grid;grid-template-columns:20px 12px 1fr auto;align-items:center;gap:6px;font-size:13px;font-weight:800;padding:2px 4px;border-radius:7px}
.board li .rk{color:var(--muted);font-variant-numeric:tabular-nums}
.board li .dot{width:10px;height:10px;border-radius:50%;border:2px solid var(--ink)}
.board li .nm{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;min-width:0}
.board li .sc{font-variant-numeric:tabular-nums}
.board li.me{background:#ffe1c9}
.board li.gap{display:block;height:4px;padding:0}
#minimap{position:absolute;right:var(--edge-r);bottom:var(--edge-b);width:150px;height:150px;border-radius:50%;padding:0}
.boost{position:absolute;left:var(--edge-l);bottom:var(--edge-b);width:92px;height:92px;border-radius:50%;
  font-family:var(--display);font-weight:800;font-size:20px;background:var(--tang);color:var(--ink);touch-action:none}
.boost.on{transform:translateY(3px);box-shadow:0 1px 0 var(--ink);background:#ffb37a}
.hint{position:absolute;left:var(--edge-l);bottom:var(--edge-b);font-size:13px;font-weight:800;color:var(--ink);
  background:rgba(255,253,246,.8);padding:6px 10px;border-radius:10px;pointer-events:none}
.feed{position:absolute;left:50%;transform:translateX(-50%);top:var(--edge-t);display:flex;flex-direction:column;align-items:center;gap:6px;pointer-events:none;width:min(360px,50vw)}
.feed-item{font-size:13px;font-weight:800;background:rgba(29,43,54,.78);color:#fff;padding:5px 12px;border-radius:999px;transition:opacity .5s;text-align:center;max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.feed-item.mine{background:var(--tang);color:var(--ink);border:2px solid var(--ink)}
.feed-item.fade{opacity:0}

/* ---------- Overlays ---------- */
.overlay{position:fixed;inset:0;display:grid;place-items:center;overflow-y:auto;
  background:rgba(29,43,54,.28);
  padding-block:calc(env(safe-area-inset-top,0px) + 20px) calc(env(safe-area-inset-bottom,0px) + 20px);
  padding-left:max(16px, env(safe-area-inset-left,0px));padding-right:max(16px, env(safe-area-inset-right,0px))}
.card{width:100%;max-width:470px;padding:22px 22px 18px;display:flex;flex-direction:column;gap:12px;border-radius:24px;box-shadow:0 7px 0 var(--ink)}
.logo{margin:0;font-family:var(--display);font-weight:800;font-size:clamp(40px,10vw,58px);line-height:.9;letter-spacing:-.01em;text-wrap:balance}
.logo span{color:var(--tang);-webkit-text-stroke:2px var(--ink);paint-order:stroke fill}
.tag{margin:-4px 0 0;font-weight:800;color:var(--muted);font-size:14px}
#preview{width:100%;height:auto;aspect-ratio:640/150;max-width:100%;border-radius:14px;border:3px solid var(--ink);background:var(--grass)}
.field-label,label{font-size:12px;font-weight:900;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);display:flex;justify-content:space-between;gap:8px}
.field-label span{color:var(--ink);letter-spacing:.02em;text-transform:none;font-size:13px}
.field{display:flex;flex-direction:column;gap:6px}
input[type=text]{font:inherit;font-weight:800;font-size:18px;padding:10px 12px;border:3px solid var(--ink);border-radius:12px;background:#fff;color:var(--ink);width:100%;box-sizing:border-box;-webkit-user-select:text;user-select:text}
.skins{display:flex;flex-wrap:wrap;gap:8px}
.skin{width:38px;height:38px;border-radius:50%;border:3px solid var(--ink);padding:0;position:relative}
.skin[aria-checked="true"]{box-shadow:0 0 0 3px var(--paper),0 0 0 6px var(--ink)}
.modes{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
.mode{border:3px solid var(--ink);border-radius:12px;background:#fff;padding:8px 6px;text-align:center;font-family:var(--display);font-weight:800;font-size:17px;line-height:1.1;display:flex;flex-direction:column;gap:3px}
.mode small{font-family:var(--body);font-weight:700;font-size:11px;line-height:1.25;color:var(--muted)}
.mode[aria-checked="true"]{background:#ffe1c9;box-shadow:0 3px 0 var(--ink)}
.play{border:3px solid var(--ink);border-radius:16px;background:var(--tang);font-family:var(--display);font-weight:800;font-size:28px;padding:8px 0 6px;box-shadow:0 5px 0 var(--ink);margin-top:4px}
.play:hover{background:#ff9a55}
.play:active{transform:translateY(4px);box-shadow:0 1px 0 var(--ink)}
.ghost-btn{border:3px solid var(--ink);border-radius:14px;background:#fff;font-family:var(--display);font-weight:800;font-size:19px;padding:7px 0 5px}
.howto{margin:0;font-size:13.5px;line-height:1.5;color:var(--ink);max-width:62ch}
.howto b{font-weight:900}
.best{margin:0;font-size:13px;font-weight:800;color:var(--muted)}
.best b{color:var(--ink);font-variant-numeric:tabular-nums}
.over-title{margin:0;font-family:var(--display);font-weight:800;font-size:clamp(30px,8vw,42px);line-height:1;text-wrap:balance}
.final{display:flex;align-items:baseline;gap:10px}
.final .num{font-family:var(--display);font-weight:800;font-size:64px;line-height:.9;font-variant-numeric:tabular-nums;color:var(--tang);-webkit-text-stroke:2px var(--ink);paint-order:stroke fill}
.final .u{font-weight:900;font-size:13px;letter-spacing:.1em;text-transform:uppercase;color:var(--muted)}
.newbest{display:inline-block;background:var(--berry);color:#fff;font-weight:900;font-size:12px;letter-spacing:.08em;text-transform:uppercase;padding:3px 9px;border-radius:999px;border:2px solid var(--ink);align-self:flex-start}
.statgrid{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}
.statgrid div{border:3px solid var(--ink);border-radius:12px;padding:6px 8px;background:#fff;min-width:0}
.statgrid dt{font-size:10.5px;font-weight:900;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}
.statgrid dd{margin:0;font-family:var(--display);font-weight:800;font-size:22px;font-variant-numeric:tabular-nums}
.btnrow{display:grid;grid-template-columns:2fr 1fr;gap:8px;align-items:end}
.btnrow .play{margin-top:0}

@media (max-width:600px){
  .board{width:150px;padding:6px 9px 8px}
  .board li{font-size:12px;grid-template-columns:16px 10px 1fr auto;gap:4px}
  .stats{min-width:108px;padding:6px 10px 8px}
  .stats .big{font-size:30px}
  .tools{top:calc(var(--edge-t) + 86px)}
  #minimap{width:104px;height:104px}
  .feed{top:auto;bottom:calc(var(--edge-b) + 110px);width:min(300px,70vw)}
  .statgrid{grid-template-columns:repeat(2,1fr)}
  .hint{display:none}
}
@media (prefers-reduced-motion:reduce){*{transition:none!important}}
</style>

<canvas id="game" aria-label="Wiggle Arena playing field"></canvas>

<div id="hud" hidden>
  <div class="stats sticker">
    <span class="lbl">Length</span>
    <span id="sLen" class="big">10</span>
    <div class="stat-row"><span>Kills <b id="sKills">0</b></span><span>Rank <b id="sRank">–</b></span></div>
  </div>
  <div class="tools">
    <button id="btnPause" class="icon-btn sticker" aria-label="Pause game">
      <svg viewBox="0 0 20 20" aria-hidden="true"><rect x="4" y="3" width="4.5" height="14" rx="1.5" fill="#1d2b36"/><rect x="11.5" y="3" width="4.5" height="14" rx="1.5" fill="#1d2b36"/></svg>
    </button>
    <button id="btnSound" class="icon-btn sticker" aria-label="Turn sound off"></button>
  </div>
  <div class="board sticker"><h2>Top snakes</h2><ol id="boardList"></ol></div>
  <canvas id="minimap" class="sticker" width="300" height="300" aria-label="Arena map"></canvas>
  <button id="btnBoost" class="boost sticker" hidden>Boost</button>
  <div class="hint" id="hint">Hold the mouse button or Space to boost · P to pause</div>
  <div id="feed" class="feed" aria-live="polite"></div>
</div>

<div id="menu" class="overlay">
  <div class="card sticker">
    <h1 class="logo">Wiggle <span>Arena</span></h1>
    <p class="tag">Eat, grow, and become the longest snake in the garden.</p>
    <canvas id="preview" width="640" height="150" aria-hidden="true"></canvas>
    <div class="field">
      <label for="nameInput">Your name</label>
      <input id="nameInput" type="text" maxlength="14" placeholder="Type a name" autocomplete="off" spellcheck="false">
    </div>
    <div class="field">
      <div class="field-label" id="skinLbl">Pick your snake <span id="skinName"></span></div>
      <div class="skins" id="skins" role="radiogroup" aria-labelledby="skinLbl"></div>
    </div>
    <div class="field">
      <div class="field-label" id="modeLbl">Arena</div>
      <div class="modes" id="modes" role="radiogroup" aria-labelledby="modeLbl">
        <button class="mode" id="mode-relaxed" role="radio" data-mode="relaxed">Relaxed<small>Bouncy walls, friendly snakes</small></button>
        <button class="mode" id="mode-classic" role="radio" data-mode="classic">Classic<small>Walls bite, some snakes hunt</small></button>
        <button class="mode" id="mode-wild" role="radio" data-mode="wild">Wild<small>Big crowd, bold hunters</small></button>
      </div>
    </div>
    <button id="btnPlay" class="play">Play</button>
    <p class="howto"><b>Move your mouse</b> and your snake follows. <b>Hold the mouse button</b> (or Space) to zoom ahead; it costs a little length. Trick other snakes into bumping your body, then gobble the treats they leave. On a phone or tablet, drag to steer and hold <b>Boost</b>.</p>
    <p class="best" id="bestMenu"></p>
  </div>
</div>

<div id="over" class="overlay" hidden>
  <div class="card sticker">
    <h2 class="over-title" id="overTitle">Oops!</h2>
    <span class="newbest" id="newBest" hidden>New best</span>
    <div class="final"><span class="num" id="overLen">0</span><span class="u">final length</span></div>
    <dl class="statgrid">
      <div><dt>Best</dt><dd id="overBest">0</dd></div>
      <div><dt>Kills</dt><dd id="overKills">0</dd></div>
      <div><dt>Time</dt><dd id="overTime">0:00</dd></div>
      <div><dt>Top rank</dt><dd id="overRank">–</dd></div>
    </dl>
    <div class="btnrow">
      <button id="btnAgain" class="play">Play again</button>
      <button id="btnMenu" class="ghost-btn">Change snake</button>
    </div>
  </div>
</div>

<div id="paused" class="overlay" hidden>
  <div class="card sticker" style="max-width:340px;text-align:center">
    <h2 class="over-title">Paused</h2>
    <p class="howto" style="margin:0 auto">Take a breather. The other snakes are waiting too.</p>
    <button id="btnResume" class="play">Resume</button>
    <button id="btnQuit" class="ghost-btn">Back to menu</button>
  </div>
</div>

<script>
(() => {
'use strict';
const TAU = Math.PI * 2, PI = Math.PI;
const $ = id => document.getElementById(id);
const clamp = (v, a, b) => v < a ? a : v > b ? b : v;
const rnd = (a, b) => a + Math.random() * (b - a);
const angDiff = (a, b) => { let d = (a - b) % TAU; if (d > PI) d -= TAU; if (d < -PI) d += TAU; return d; };

const store = {
  get(k, d) { try { const v = localStorage.getItem('wiggle.' + k); return v === null ? d : JSON.parse(v); } catch (e) { return d; } },
  set(k, v) { try { localStorage.setItem('wiggle.' + k, JSON.stringify(v)); } catch (e) {} }
};

/* ---------- Content ---------- */
const RAINBOW = ['#ff595e', '#ff924c', '#ffca3a', '#8ac926', '#1982c4', '#6a4c93'];
const SKINS = [
  { id: 'bubblegum', name: 'Bubblegum', a: '#ff7eb6', b: '#ffd0e6', style: 'stripe' },
  { id: 'lagoon',    name: 'Lagoon',    a: '#22b8ec', b: '#bdeeff', style: 'stripe' },
  { id: 'lemon',     name: 'Lemon Drop',a: '#ffcc29', b: '#fff4b8', style: 'dots' },
  { id: 'grape',     name: 'Grape',     a: '#9b5de5', b: '#dcc8ff', style: 'stripe' },
  { id: 'tiger',     name: 'Tiger',     a: '#ff8a3d', b: '#2b2b2b', style: 'tiger' },
  { id: 'cherry',    name: 'Cherry',    a: '#ef476f', b: '#ffc6d3', style: 'dots' },
  { id: 'mint',      name: 'Mint Chip', a: '#2fbf8f', b: '#d2f7e8', style: 'stripe' },
  { id: 'midnight',  name: 'Midnight',  a: '#3949a8', b: '#a6b4ff', style: 'stripe' },
  { id: 'rainbow',   name: 'Rainbow',   a: '#ff595e', b: '#ffca3a', style: 'rainbow' },
];
const FOOD_COLORS = ['#ff595e', '#ffca3a', '#8ac926', '#1982c4', '#6a4c93', '#ff8fab', '#ff924c', '#4cc9f0'];
const BOT_NAMES = ['Noodle','Ziggy','Pickles','Bubbles','Mango','Sir Wiggles','Pebble','Kiwi','Waffles','Coco','Doodle','Biscuit',
  'Sprinkles','Tango','Pip','Jellybean','Rocket','Marble','Taffy','Zuzu','Fizz','Nimbus','Pudding','Socks','Lulu','Domino',
  'Peaches','Gizmo','Churro','Bean','Scribble','Sunny','Mochi','Twix','Banjo','Nugget','Olive','Pretzel','Zap','Dumpling'];

const MODES = {
  relaxed: { label: 'Relaxed', bots: 10, speed: 0.82, aggro: 0,    maxStart: 35,  softEdge: true },
  classic: { label: 'Classic', bots: 18, speed: 1.0,  aggro: 0.25, maxStart: 90,  softEdge: false },
  wild:    { label: 'Wild',    bots: 26, speed: 1.06, aggro: 0.7,  maxStart: 200, softEdge: false },
};

const WORLD_R = 2400, FOOD_TARGET = 800, MIN_BOOST = 14, BASE_SPEED = 2.7, CELL = 90;

function shade(hex, f) {
  const n = parseInt(hex.slice(1), 16);
  let r = n >> 16, g = (n >> 8) & 255, b = n & 255;
  r = Math.round(r * (1 + f)); g = Math.round(g * (1 + f)); b = Math.round(b * (1 + f));
  return '#' + ((1 << 24) | (clamp(r,0,255) << 16) | (clamp(g,0,255) << 8) | clamp(b,0,255)).toString(16).slice(1);
}
SKINS.forEach(s => { s.dark = s.style === 'rainbow' ? '#2b2340' : s.style === 'tiger' ? '#1d1d1d' : shade(s.a, -0.5); });
function segColor(skin, i) {
  switch (skin.style) {
    case 'dots': return i % 5 === 2 ? skin.b : skin.a;
    case 'tiger': return Math.floor(i / 2) % 3 === 0 ? skin.b : skin.a;
    case 'rainbow': return RAINBOW[Math.floor(i / 3) % RAINBOW.length];
    default: return Math.floor(i / 3) % 2 ? skin.b : skin.a;
  }
}
const radius = m => Math.min(40, 8.5 + Math.sqrt(m) * 1.25);
const segCount = m => Math.min(320, Math.floor(10 + m * 0.45));

/* ---------- Canvas ---------- */
const cv = $('game'), ctx = cv.getContext('2d');
const mm = $('minimap'), mctx = mm.getContext('2d');
const pv = $('preview'), pctx = pv.getContext('2d');
let W = 0, H = 0, DPR = 1;
function resize() {
  DPR = Math.min(window.devicePixelRatio || 1, 2);
  W = window.innerWidth; H = window.innerHeight;
  cv.width = Math.round(W * DPR); cv.height = Math.round(H * DPR);
  cv.style.width = W + 'px'; cv.style.height = H + 'px';
}
window.addEventListener('resize', resize); resize();

function makeTile() {
  const c = document.createElement('canvas'); c.width = c.height = 72;
  const g = c.getContext('2d');
  g.fillStyle = '#b9e4c4'; g.fillRect(0, 0, 72, 72);
  g.fillStyle = '#aad9b7';
  for (const [x, y] of [[0,0],[72,0],[0,72],[72,72],[36,36]]) { g.beginPath(); g.arc(x, y, 27, 0, TAU); g.fill(); }
  g.fillStyle = 'rgba(255,255,255,.28)';
  for (const [x, y] of [[0,0],[72,0],[0,72],[72,72],[36,36]]) { g.beginPath(); g.arc(x - 8, y - 9, 6, 0, TAU); g.fill(); }
  return c;
}
const tile = makeTile();
const grassPat = ctx.createPattern(tile, 'repeat');
const previewPat = pctx.createPattern(tile, 'repeat');

/* ---------- State ---------- */
let modeKey = store.get('mode', 'classic'); if (!MODES[modeKey]) modeKey = 'classic';
let M = MODES[modeKey];
let skinIdx = clamp(store.get('skin', 0) | 0, 0, SKINS.length - 1);
let snakes = [], foods = [], effects = [], player = null, nextId = 1, naturalCount = 0, clock = 0;
let state = 'menu', botTimer = 0, deadTimer = 0, deathMsg = '';
const cam = { x: 0, y: 0, z: 0.9, follow: null };
const run = { start: 0, kills: 0, bestRank: 99, peak: 10, time: 0, pausedAt: 0 };
const input = { mx: 0, my: 0, boost: false, keyBoost: false, turn: 0, usePointer: false };

/* ---------- Food ---------- */
function addFood(x, y, v, color, natural) {
  if (!natural && foods.length > 2600) return;
  foods.push({ x, y, v, r: Math.min(14, 3.5 + Math.sqrt(v) * 2.2), c: color || FOOD_COLORS[(Math.random() * FOOD_COLORS.length) | 0],
               ph: Math.random() * TAU, natural: !!natural, dead: false });
  if (natural) naturalCount++;
}
function addNaturalFood() {
  const a = Math.random() * TAU, d = Math.sqrt(Math.random()) * (WORLD_R - 40);
  addFood(Math.cos(a) * d, Math.sin(a) * d, Math.random() < 0.07 ? 3 : 1, null, true);
}

/* ---------- Snakes ---------- */
function makeSnake(o) {
  const r = radius(o.mass), sp = r * 0.46, n = segCount(o.mass), pts = [];
  for (let i = 0; i < n; i++) pts.push({ x: o.x - Math.cos(o.angle) * sp * i, y: o.y - Math.sin(o.angle) * sp * i });
  return { id: nextId++, name: o.name, skin: o.skin, mass: o.mass, r, pts, angle: o.angle, target: o.angle,
           boost: false, boosting: false, boostAcc: 0, alive: true, isPlayer: !!o.isPlayer, kills: 0, grace: o.grace || 0,
           ai: { t: 0, dt: 0, wander: o.angle } };
}
function freeSpot(minFromPlayer) {
  let best = null, bestD = -1;
  for (let k = 0; k < 24; k++) {
    const a = Math.random() * TAU, d = Math.sqrt(Math.random()) * WORLD_R * 0.8;
    const x = Math.cos(a) * d, y = Math.sin(a) * d;
    let md = 1e12;
    for (const s of snakes) {
      if (!s.alive) continue;
      for (let i = 0; i < s.pts.length; i += 4) { const p = s.pts[i], dd = (p.x - x) ** 2 + (p.y - y) ** 2; if (dd < md) md = dd; }
    }
    if (player && player.alive && minFromPlayer) {
